# MCP Server Environment Variables

# NewsData.io API Configuration
# Get your free API key from: https://newsdata.io/
NEWSDATA_API_KEY=your_newsdata_api_key_here

# Remote HTTP Server Configuration (for mcp-server-remote)
# Use 127.0.0.1 for local testing, 0.0.0.0 for remote deployment
MCP_REMOTE_HOST=127.0.0.1
MCP_REMOTE_PORT=8000
